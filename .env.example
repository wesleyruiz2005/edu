# Copia este archivo a ".env" y coloca la cadena de conexión real de tu base de datos
# (la obtienes desde el panel de Supabase o Neon, sección "Connection string").
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_base_datos?schema=public"

# Clave secreta para firmar la cookie de inicio de sesión. Para la prueba
# local puedes dejarla así o poner cualquier texto largo -- para un uso
# real (no solo la prueba) usa un texto propio, largo y secreto (por
# ejemplo, generado con: openssl rand -base64 32).
AUTH_SECRET="cambia-este-texto-por-uno-propio-largo-y-secreto-2026"
