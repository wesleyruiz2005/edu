model ActivoFijo {
  id                        Int             @id @default(autoincrement())
  colegioId                 Int             @map("colegio_id")
  colegio                   Colegio         @relation(fields: [colegioId], references: [id])
  nombreActivo              String          @map("nombre_activo")
  categoriaId               Int             @map("categoria_id")
