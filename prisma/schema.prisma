// ============================================================================
// Sistema Contable Multi-Colegio — Prisma Schema
// Fuente: diseno-base-datos.md (proyecto "Sistema Contable Para Colegios")
// Motor: PostgreSQL (Supabase / Neon)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. NÚCLEO / CATÁLOGOS GENERALES
// ============================================================================

enum TipoColegio {
  PREESCOLAR_PRIMARIA
  INSTITUTO_TECNICO
}

/// Distingue los "libros contables" (empresas) que conviven en el mismo
/// sistema: el del colegio (córdobas, DGI/MINED) y el del Programa ICCM
/// (dólares, patrocinios FMC-USA). Comparten el motor de partida doble
/// (Comprobante/AsientoContable) pero NUNCA se mezclan sus catálogos de
/// cuentas -- por eso `CatalogoCuenta.codigo` ya no es único a secas, sino
/// único POR libro (dos libros pueden reusar el mismo código, ej. ambos
/// tienen un "110101 Caja General" que son cuentas distintas).
enum LibroContable {
  COLEGIO
  ICCM
}

model Colegio {
  id           Int         @id @default(autoincrement())
  codigo       String      @unique @db.VarChar(10) // ej. CMLM, CBP, ITML
  nombre       String      @db.VarChar(150)
  tipo         TipoColegio
  direccion    String?
  telefono     String?
  ruc          String?
  /// Prefijo de código ICCM de esta sede (NC100 = El Mesías, NC200 = El Buen
  /// Pastor, NC300 = Instituto Tecnológico) -- permite ubicar automáticamente
  /// a qué colegio pertenece un niño patrocinado por su código NC-xxx-xxxxx.
  prefijoIccm  String?     @map("prefijo_iccm") @db.VarChar(10)
  activo       Boolean     @default(true)
  creadoEn     DateTime    @default(now()) @map("creado_en")

  secciones             Seccion[]
  estudiantes           Estudiante[]
  combosPromocion       ComboPromocion[]
  recibosCaja           ReciboCaja[]
  controlDepositos      ControlDepositoDiario[]
  saldosIniciales       SaldoInicial[]
  comprobantes          Comprobante[]
  cajaChicaConfig       CajaChicaConfig?
  cajaChicaMovimientos  CajaChicaMovimiento[]
  activosFijos          ActivoFijo[]
  articulosInventario   ArticuloInventario[]
  terceros              TerceroBeneficiario[]
  reglasMora            ReglaMora[]
  iccmNinos             IccmNino[]
  iccmRegalos           IccmRegalo[]
  pagosProveedor        PagoProveedor[]
  comprobanteContadores ComprobanteContadorMensual[]
  cierresContables      CierreContable[]
  cierresAnuales        CierreAnual[]
  empleados             Empleado[]
  planillasMensuales    PlanillaMensual[]

  @@map("colegios")
}

model AnioLectivo {
  id           Int       @id @default(autoincrement())
  anio         Int       @unique
  fechaInicio  DateTime? @db.Date @map("fecha_inicio")
  fechaFin     DateTime? @db.Date @map("fecha_fin")
  cerrado      Boolean   @default(false)

  secciones                  Seccion[]
  cargosEstudiante           CargoEstudiante[]
  estudianteComboPromocion   EstudianteComboPromocion[]
  saldosIniciales            SaldoInicial[]
  comprobantes               Comprobante[]

  @@map("anios_lectivos")
}

model Modalidad {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(60) // Educación Preescolar y Primaria, Secundaria Regular, Secundaria Técnica, Cursos Libres, Carreras Técnicas, ICCM

  nivelesAcademicos  NivelAcademico[]
  estudiantes        Estudiante[]
  historialModalidad HistorialModalidad[]

  @@map("modalidades")
}

/// Registra los cambios de modalidad de un estudiante a lo largo del año
/// (ej. de "Secundaria Técnica" a "Secundaria Regular" a mitad de año por
/// motivos económicos). `Estudiante.modalidadId` siempre guarda la
/// modalidad ACTUAL (para inscripciones nuevas y reportes rápidos); esta
/// tabla es la que consulta el motor de facturación para saber con qué
/// tarifa/cuenta facturar CADA mes según la modalidad vigente en ese mes
/// específico -- así los meses ya facturados con la tarifa anterior no
/// cambian, y los meses restantes sí usan la tarifa nueva automáticamente.
model HistorialModalidad {
  id           Int        @id @default(autoincrement())
  estudianteId Int        @map("estudiante_id")
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id])
  modalidadId  Int        @map("modalidad_id")
  modalidad    Modalidad  @relation(fields: [modalidadId], references: [id])
  vigenteDesde DateTime   @db.Date @map("vigente_desde")
  vigenteHasta DateTime?  @db.Date @map("vigente_hasta") // null = sigue vigente
  motivo       String?
  creadoEn     DateTime   @default(now()) @map("creado_en")

  @@index([estudianteId, vigenteDesde])
  @@map("historial_modalidad")
}

model NivelAcademico {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(60) // I Nivel, II Nivel, III Nivel, 1ro...6to, Secundaria, Cursos Libres, Carrera Técnica X
  modalidadId       Int       @map("modalidad_id")
  modalidad         Modalidad @relation(fields: [modalidadId], references: [id])
  orden             Int       @default(0)
  esNivelGraduacion Boolean   @default(false) @map("es_nivel_graduacion")

  secciones       Seccion[]
  estudiantes     Estudiante[]
  combosPromocion ComboPromocion[]

  @@unique([nombre, modalidadId])
  @@map("niveles_academicos")
}

model Seccion {
  id               Int            @id @default(autoincrement())
  colegioId        Int            @map("colegio_id")
  colegio          Colegio        @relation(fields: [colegioId], references: [id])
  nivelAcademicoId Int            @map("nivel_academico_id")
  nivelAcademico   NivelAcademico @relation(fields: [nivelAcademicoId], references: [id])
  anioLectivoId    Int            @map("anio_lectivo_id")
  anioLectivo      AnioLectivo    @relation(fields: [anioLectivoId], references: [id])
  nombreSeccion    String         @db.VarChar(20) @map("nombre_seccion") // "A", "B", "Única"
  docenteGuia      String?        @map("docente_guia")

  estudiantes Estudiante[]

  @@unique([colegioId, nivelAcademicoId, anioLectivoId, nombreSeccion])
  @@map("secciones")
}

model ConceptoArancel {
  id                   Int            @id @default(autoincrement())
  nombre               String         @unique @db.VarChar(80) // Matrícula, Mensualidad, Papelería, Décimo Tercer Mes, etc.
  cuentaContableId     Int            @map("cuenta_contable_id")
  cuentaContable       CatalogoCuenta @relation(fields: [cuentaContableId], references: [id])
  esRecurrenteMensual  Boolean        @default(false) @map("es_recurrente_mensual")
  aplicaRecargoMora    Boolean        @default(false) @map("aplica_recargo_mora")

  cargosEstudiante  CargoEstudiante[]
  recibosDetalle    ReciboDetalle[]
  tiposBecaAplicables TipoBeca[]

  @@map("conceptos_arancel")
}

model TasaCambio {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @unique @db.Date
  valorCPorUsd  Decimal  @db.Decimal(10, 4) @map("valor_c_por_usd")

  @@map("tasas_cambio")
}

model ReglaMora {
  id                  Int       @id @default(autoincrement())
  colegioId           Int?      @map("colegio_id") // null = regla global para todos los colegios
  colegio             Colegio?  @relation(fields: [colegioId], references: [id])
  diaLimitePago       Int       @default(5) @map("dia_limite_pago")
  porcentajeRecargo   Decimal   @default(10.00) @db.Decimal(5, 2) @map("porcentaje_recargo")
  vigenteDesde        DateTime  @db.Date @map("vigente_desde")

  @@map("reglas_mora")
}

// ============================================================================
// 2. ESTUDIANTES Y BECAS
// ============================================================================

model Estudiante {
  id                   Int             @id @default(autoincrement())
  colegioId            Int             @map("colegio_id")
  colegio              Colegio         @relation(fields: [colegioId], references: [id])
  codigoEstudiantil    String          @db.VarChar(20) @map("codigo_estudiantil") // CMLM-2026-001
  nombreCompleto       String          @db.VarChar(150) @map("nombre_completo")
  nivelAcademicoId     Int             @map("nivel_academico_id")
  nivelAcademico       NivelAcademico  @relation(fields: [nivelAcademicoId], references: [id])
  seccionId            Int?            @map("seccion_id")
  seccion              Seccion?        @relation(fields: [seccionId], references: [id])
  modalidadId          Int             @map("modalidad_id")
  modalidad            Modalidad       @relation(fields: [modalidadId], references: [id])
  codigoMined          String?         @map("codigo_mined")
  codigoInatec         String?         @map("codigo_inatec")
  nombreTutor          String          @db.VarChar(150) @map("nombre_tutor")
  cedulaTutor          String?         @map("cedula_tutor")
  telefonoTutor        String?         @map("telefono_tutor")
  direccion            String?
  correo               String?
  programa             String?         // ej. "ICCM"
  /// "Ficha dinámica": estos 4 montos se fijan al inscribir o promover al
  /// alumno y son la fuente para TODOS los cargos que se le generen (becas
  /// completas, medias becas, tarifas de cupos ICCM, etc. se reflejan aquí
  /// directamente, no como una fórmula aparte).
  montoMatriculaBase     Decimal       @db.Decimal(12, 2) @map("monto_matricula_base")
  montoMensualidadBase   Decimal       @db.Decimal(12, 2) @map("monto_mensualidad_base")
  /// null = usar el mismo monto que Matrícula (así viene en el 99% de los
  /// casos reales del Excel); se fija aparte solo para la excepción puntual.
  montoPapeleriaBase     Decimal?      @db.Decimal(12, 2) @map("monto_papeleria_base")
  /// null = usar el mismo monto que Matrícula.
  montoDecimoTercerBase  Decimal?      @db.Decimal(12, 2) @map("monto_decimo_tercer_base")
  /// Código NC del Programa ICCM (ej. "NC100-00118") si el alumno está
  /// apadrinado -- enlaza su ficha del colegio con su ficha de patrocinio.
  codigoIccm             String?       @unique @map("codigo_iccm")
  fechaIngreso           DateTime?     @db.Date @map("fecha_ingreso")
  activo                 Boolean       @default(true)

  becas                     EstudianteBeca[]
  cargos                    CargoEstudiante[]
  recibosCaja               ReciboCaja[]
  combosPromocion           EstudianteComboPromocion[]
  recorridoEstudiantil      RecorridoEstudiantil[]
  mensajesWhatsapp          MensajeCobranzaWhatsapp[]
  movimientosInventario     MovimientoInventario[]
  historialModalidad        HistorialModalidad[]
  iccmNino                  IccmNino?

  @@unique([colegioId, codigoEstudiantil])
  @@map("estudiantes")
}

enum TipoCalculoBeca {
  PORCENTAJE
  MONTO_FIJO
}

model TipoBeca {
  id                 Int              @id @default(autoincrement())
  nombre             String           @db.VarChar(60) // Media Beca, Beca Interna 100%, Exoneración Papelería...
  tipoCalculo        TipoCalculoBeca  @map("tipo_calculo")
  valor              Decimal          @db.Decimal(8, 2) // 50.00 (=50%) o monto en córdobas
  aplicaAConceptoId  Int?             @map("aplica_a_concepto_id") // null = aplica a todos los conceptos recurrentes
  aplicaAConcepto    ConceptoArancel? @relation(fields: [aplicaAConceptoId], references: [id])

  estudianteBecas EstudianteBeca[]

  @@map("tipos_beca")
}

model EstudianteBeca {
  id              Int        @id @default(autoincrement())
  estudianteId    Int        @map("estudiante_id")
  estudiante      Estudiante @relation(fields: [estudianteId], references: [id])
  tipoBecaId      Int        @map("tipo_beca_id")
  tipoBeca        TipoBeca   @relation(fields: [tipoBecaId], references: [id])
  fechaInicio     DateTime   @db.Date @map("fecha_inicio")
  fechaFin        DateTime?  @db.Date @map("fecha_fin") // null = vigente
  autorizadoPor   String?    @map("autorizado_por")
  observacion     String?

  cargosEstudiante CargoEstudiante[]

  @@map("estudiante_becas")
}

// ============================================================================
// 3. FACTURACIÓN / INGRESOS RECURRENTES
// ============================================================================

enum EstadoCargo {
  PENDIENTE
  PARCIAL
  PAGADO
  VENCIDO
}

model CargoEstudiante {
  id                        BigInt           @id @default(autoincrement())
  estudianteId              Int              @map("estudiante_id")
  estudiante                Estudiante       @relation(fields: [estudianteId], references: [id])
  conceptoId                Int              @map("concepto_id")
  concepto                  ConceptoArancel  @relation(fields: [conceptoId], references: [id])
  anioLectivoId             Int              @map("anio_lectivo_id")
  anioLectivo               AnioLectivo      @relation(fields: [anioLectivoId], references: [id])
  mes                       Int?             // 1-12 para conceptos mensuales; null para Matrícula/Papelería/Décimo Tercero
  montoOriginal             Decimal          @db.Decimal(12, 2) @map("monto_original")
  becaAplicadaId            Int?             @map("beca_aplicada_id")
  becaAplicada              EstudianteBeca?  @relation(fields: [becaAplicadaId], references: [id])
  montoFacturado            Decimal          @db.Decimal(12, 2) @map("monto_facturado")
  fechaVencimiento          DateTime         @db.Date @map("fecha_vencimiento")
  recargoMoraPctAplicado    Decimal?         @db.Decimal(5, 2) @map("recargo_mora_pct_aplicado")
  recargoMoraMonto          Decimal          @default(0) @db.Decimal(12, 2) @map("recargo_mora_monto")
  montoPagadoAcumulado      Decimal          @default(0) @db.Decimal(12, 2) @map("monto_pagado_acumulado")
  saldoPendiente            Decimal          @db.Decimal(12, 2) @map("saldo_pendiente")
  estado                    EstadoCargo      @default(PENDIENTE)
  creadoEn                  DateTime         @default(now()) @map("creado_en")

  recibosDetalle            ReciboDetalle[]
  comboPromocionAsignado    EstudianteComboPromocion?

  @@unique([estudianteId, conceptoId, anioLectivoId, mes])
  @@index([estudianteId, estado])
  @@map("cargos_estudiante")
}

model ComboPromocion {
  id               Int            @id @default(autoincrement())
  colegioId        Int            @map("colegio_id")
  colegio          Colegio        @relation(fields: [colegioId], references: [id])
  nivelAcademicoId Int            @map("nivel_academico_id") // nivel que gradúa (III Nivel, 6to grado...)
  nivelAcademico   NivelAcademico @relation(fields: [nivelAcademicoId], references: [id])
  nombre           String         @db.VarChar(30) // Combo 1...6
  incluye          String?        // "Toga, Birrete, Porta Diploma, Fotos..."
  costoTotal       Decimal        @db.Decimal(12, 2) @map("costo_total")

  asignaciones EstudianteComboPromocion[]

  @@map("combos_promocion")
}

model EstudianteComboPromocion {
  id                  Int              @id @default(autoincrement())
  estudianteId        Int              @map("estudiante_id")
  estudiante          Estudiante       @relation(fields: [estudianteId], references: [id])
  comboId             Int              @map("combo_id")
  combo               ComboPromocion   @relation(fields: [comboId], references: [id])
  anioLectivoId       Int              @map("anio_lectivo_id")
  anioLectivo         AnioLectivo      @relation(fields: [anioLectivoId], references: [id])
  fechaAsignacion     DateTime         @db.Date @map("fecha_asignacion")
  cargoEstudianteId   BigInt?          @unique @map("cargo_estudiante_id") // el cargo generado (concepto = Ingresos por Promoción)
  cargoEstudiante     CargoEstudiante? @relation(fields: [cargoEstudianteId], references: [id])

  @@map("estudiante_combo_promocion")
}

enum TipoServicioTransporte {
  IDA_Y_VUELTA
  SOLO_IDA
  SOLO_VUELTA
  NO_APLICA
}

model RecorridoEstudiantil {
  id             Int                    @id @default(autoincrement())
  estudianteId   Int                    @map("estudiante_id")
  estudiante     Estudiante             @relation(fields: [estudianteId], references: [id])
  tipoServicio   TipoServicioTransporte @map("tipo_servicio")
  tarifaMensual  Decimal                @db.Decimal(12, 2) @map("tarifa_mensual")
  vigenteDesde   DateTime               @db.Date @map("vigente_desde")
  vigenteHasta   DateTime?              @db.Date @map("vigente_hasta")

  @@map("recorrido_estudiantil")
}

// ============================================================================
// 4. COBROS Y CAJA
// ============================================================================

enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

model ReciboCaja {
  id           BigInt      @id @default(autoincrement())
  colegioId    Int         @map("colegio_id")
  colegio      Colegio     @relation(fields: [colegioId], references: [id])
  numeroRoc    String      @map("numero_roc")
  fecha        DateTime    @db.Date
  estudianteId Int?        @map("estudiante_id")
  estudiante   Estudiante? @relation(fields: [estudianteId], references: [id])
  montoTotal   Decimal     @db.Decimal(12, 2) @map("monto_total")
  formaPago    FormaPago   @default(EFECTIVO) @map("forma_pago")
  observacion  String?
  anulado      Boolean     @default(false)
  creadoPor    String?     @map("creado_por")
  creadoEn     DateTime    @default(now()) @map("creado_en")

  detalle ReciboDetalle[]

  @@unique([colegioId, numeroRoc])
  @@map("recibos_caja")
}

model ReciboDetalle {
  id                  BigInt           @id @default(autoincrement())
  reciboId            BigInt           @map("recibo_id")
  recibo              ReciboCaja       @relation(fields: [reciboId], references: [id])
  cargoEstudianteId   BigInt?          @map("cargo_estudiante_id")
  cargoEstudiante     CargoEstudiante? @relation(fields: [cargoEstudianteId], references: [id])
  conceptoId          Int              @map("concepto_id")
  concepto            ConceptoArancel  @relation(fields: [conceptoId], references: [id])
  montoPagado         Decimal          @db.Decimal(12, 2) @map("monto_pagado")
  incluyeRecargoMora  Decimal          @default(0) @db.Decimal(12, 2) @map("incluye_recargo_mora")
  cuentaContableId    Int              @map("cuenta_contable_id")
  cuentaContable      CatalogoCuenta   @relation(fields: [cuentaContableId], references: [id])
  /// El asiento de partida doble que este pago generó automáticamente
  /// (Débito Caja / Crédito la cuenta que corresponda). Lo llena la Pantalla
  /// de Cajera en la misma transacción que crea este renglón.
  comprobanteId       BigInt?          @map("comprobante_id")
  comprobante         Comprobante?     @relation(fields: [comprobanteId], references: [id])
  /// true si este pago se contabilizó contra el pasivo 2110 (Ingresos
  /// Recibidos por Anticipado) por ser un abono a un año lectivo futuro.
  esAnticipo          Boolean          @default(false) @map("es_anticipo")
  /// true una vez que el job del 01 de enero ya trasladó este anticipo del
  /// pasivo 2110 al ingreso real. Evita regularizar el mismo pago dos veces.
  regularizado        Boolean          @default(false)

  movimientoInventario MovimientoInventario?

  @@map("recibo_detalle")
}

model ControlDepositoDiario {
  id                  Int      @id @default(autoincrement())
  colegioId           Int      @map("colegio_id")
  colegio             Colegio  @relation(fields: [colegioId], references: [id])
  fecha               DateTime @db.Date
  totalIngresosDia    Decimal  @db.Decimal(12, 2) @map("total_ingresos_dia")
  efectivoDepositado  Decimal  @db.Decimal(12, 2) @map("efectivo_depositado")
  banco               String?
  noBoleta            String?  @map("no_boleta")
  diferencia          Decimal  @db.Decimal(12, 2)
  entregadoPor        String?  @map("entregado_por")
  recibidoPor         String?  @map("recibido_por")
  observaciones       String?

  @@unique([colegioId, fecha])
  @@map("control_depositos_diarios")
}

model MensajeCobranzaWhatsapp {
  id                       BigInt     @id @default(autoincrement())
  estudianteId             Int        @map("estudiante_id")
  estudiante               Estudiante @relation(fields: [estudianteId], references: [id])
  fechaGenerado            DateTime   @default(now()) @map("fecha_generado")
  saldoAlMomento           Decimal    @db.Decimal(12, 2) @map("saldo_al_momento")
  detalleMesesPendientes   String?    @map("detalle_meses_pendientes")
  mensajeTexto             String     @map("mensaje_texto")
  enviado                  Boolean    @default(false)
  fechaEnvio               DateTime?  @map("fecha_envio")

  @@map("mensajes_cobranza_whatsapp")
}

// ============================================================================
// 5. CONTABILIDAD FORMAL (PARTIDA DOBLE)
// ============================================================================

enum TipoCuentaContable {
  MAYOR   // agrupadora, no recibe asientos
  DETALLE // transaccional
}

enum ClaseCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  COSTO
  GASTO
  CIERRE
  ORDEN_DEUDORA
  ORDEN_ACREEDORA
}

enum NaturalezaCuenta {
  DEUDORA
  ACREEDORA
}

model CatalogoCuenta {
  id             Int                @id @default(autoincrement())
  /// El código YA NO es único por sí solo -- es único DENTRO de cada libro
  /// (ver `LibroContable`). Dos libros distintos pueden tener, por ejemplo,
  /// ambos un código "110101 Caja General" que son cuentas completamente
  /// distintas (la caja del colegio vs. la caja del Programa ICCM).
  libro          LibroContable      @default(COLEGIO)
  codigo         String             @db.VarChar(15)
  nombre         String             @db.VarChar(150)
  cuentaPadreId  Int?               @map("cuenta_padre_id")
  cuentaPadre    CatalogoCuenta?    @relation("CuentaJerarquia", fields: [cuentaPadreId], references: [id])
  hijos          CatalogoCuenta[]   @relation("CuentaJerarquia")
  tipoCuenta     TipoCuentaContable @map("tipo_cuenta")
  clase          ClaseCuenta
  naturaleza     NaturalezaCuenta
  nivel          Int
  activo         Boolean            @default(true) // false = código reservado/sin nombrar aún en el Excel origen

  conceptosArancel        ConceptoArancel[]
  recibosDetalle          ReciboDetalle[]
  saldosIniciales         SaldoInicial[]
  asientosContables       AsientoContable[]
  cajaChicaMovimientos    CajaChicaMovimiento[]
  terceroDebito           TerceroBeneficiario[] @relation("CuentaDebitoFrecuente")
  terceroCredito          TerceroBeneficiario[] @relation("CuentaCreditoFrecuente")
  categoriaActivoCuenta   CategoriaActivo[]     @relation("CategoriaCuentaActivo")
  categoriaDeprecAcum     CategoriaActivo[]     @relation("CategoriaCuentaDeprecAcumulada")
  categoriaGasto          CategoriaActivo[]     @relation("CategoriaCuentaGasto")
  pagoProveedorDetalle    PagoProveedorDetalle[]
  pagosProveedorOrigen    PagoProveedor[]       @relation("CuentaOrigenPago")
  pagosProveedorRetencion PagoProveedor[]       @relation("CuentaRetencionPago")

  @@unique([libro, codigo])
  @@map("catalogo_cuentas")
}

model TerceroBeneficiario {
  id                        Int             @id @default(autoincrement())
  colegioId                 Int?            @map("colegio_id") // null = compartido entre colegios
  colegio                   Colegio?        @relation(fields: [colegioId], references: [id])
  nombreCompleto            String          @map("nombre_completo")
  nombreComercial           String?         @map("nombre_comercial")
  rucCedula                 String?         @map("ruc_cedula")
  correo                    String?
  telefono                  String?
  conceptoFrecuente         String?         @map("concepto_frecuente")
  cuentaDebitoFrecId        Int?            @map("cuenta_debito_frec_id")
  cuentaDebitoFrec          CatalogoCuenta? @relation("CuentaDebitoFrecuente", fields: [cuentaDebitoFrecId], references: [id])
  cuentaCreditoFrecId       Int?            @map("cuenta_credito_frec_id")
  cuentaCreditoFrec         CatalogoCuenta? @relation("CuentaCreditoFrecuente", fields: [cuentaCreditoFrecId], references: [id])
  /// Módulo de Pago (punto 7 de la especificación de Eduardo, 7 sept 2026):
  /// true = el proveedor tiene una "constancia de no retención" vigente de
  /// la DGI -- se le exonera de TODA retención mientras la constancia no
  /// venza. false/sin fecha = se le retiene según la regla normal (2%/10%).
  tieneConstanciaNoRetencion Boolean        @default(false) @map("tiene_constancia_no_retencion")
  /// Fecha de vencimiento de esa constancia. Si es null pero
  /// `tieneConstanciaNoRetencion=true`, se trata como vigente indefinidamente
  /// (avisar a Eduardo para que confirme fecha real cuando la tenga).
  constanciaVigenciaHasta    DateTime?      @db.Date @map("constancia_vigencia_hasta")

  comprobantes           Comprobante[]
  movimientosInventario  MovimientoInventario[]
  pagosProveedor         PagoProveedor[]

  @@map("terceros_beneficiarios")
}

model SaldoInicial {
  id             Int            @id @default(autoincrement())
  colegioId      Int            @map("colegio_id")
  colegio        Colegio        @relation(fields: [colegioId], references: [id])
  cuentaId       Int            @map("cuenta_id")
  cuenta         CatalogoCuenta @relation(fields: [cuentaId], references: [id])
  anioLectivoId  Int            @map("anio_lectivo_id")
  anioLectivo    AnioLectivo    @relation(fields: [anioLectivoId], references: [id])
  debeInicial    Decimal        @default(0) @db.Decimal(14, 2) @map("debe_inicial")
  haberInicial   Decimal        @default(0) @db.Decimal(14, 2) @map("haber_inicial")

  @@unique([colegioId, cuentaId, anioLectivoId])
  @@map("saldos_iniciales")
}

enum TipoComprobante {
  REC    // recaudación automática
  CD     // comprobante de diario
  CK     // comprobante de cheque
  CIERRE // asiento de cierre (depreciación, ajustes)
}

enum OrigenComprobante {
  MANUAL
  AUTO_RECAUDACION
  AUTO_DEPRECIACION
  AUTO_CIERRE
  /// Cobro de un arancel del año lectivo SIGUIENTE recibido en el año
  /// actual (ej. matrícula anticipada) -- se contabiliza contra el pasivo
  /// 2110 "Ingresos Recibidos por Anticipado" en vez de contra el ingreso.
  AUTO_ANTICIPO
  /// Asiento masivo del 01 de enero que traslada el pasivo 2110 al ingreso
  /// real, una vez que el año lectivo que se anticipó ya inició.
  AUTO_REGULARIZACION_ANTICIPO
  /// Libro ICCM: ingreso de un patrocinio/donación mensual o un regalo.
  AUTO_ICCM_INGRESO
  /// Libro ICCM: comisión bancaria (BAC Nicaragua o comisión internacional).
  AUTO_ICCM_COMISION
  /// Libro ICCM: liberación de fondos que estaban retenidos por foto/carta
  /// atrasada, una vez que el estudiante deja de estar retenido.
  AUTO_ICCM_LIBERACION
  /// Comprobante migrado desde un Excel histórico (ver
  /// scripts/importar-historico-iccm.ts) -- no lo generó el sistema en
  /// tiempo real, se trasladó tal cual del libro diario original.
  IMPORTACION_HISTORICA
  /// Módulo de Pago a Proveedores (7 sept 2026): pago generado por
  /// `registrarPagoProveedor()` -- amarra automáticamente Caja/Banco,
  /// Retenciones por Pagar y la(s) cuenta(s) de gasto elegidas.
  AUTO_PAGO_PROVEEDOR
  /// Asiento de nómina generado por el Módulo de Nóminas.
  AUTO_NOMINA
}

enum EstadoComprobante {
  CUADRADO
  DESCUADRADO
}

model Comprobante {
  id                  BigInt              @id @default(autoincrement())
  colegioId           Int                 @map("colegio_id")
  colegio             Colegio             @relation(fields: [colegioId], references: [id])
  /// A qué "empresa"/libro pertenece este comprobante -- ver `LibroContable`.
  /// La numeración de `claveComprobante` es independiente por libro.
  libro               LibroContable       @default(COLEGIO)
  tipoComprobante     TipoComprobante     @map("tipo_comprobante")
  numeroComprobante   Int                 @map("numero_comprobante")
  claveComprobante    String              @map("clave_comprobante") // tipo + '-' + numero
  fecha               DateTime            @db.Date
  concepto            String?
  beneficiarioId      Int?                @map("beneficiario_id")
  beneficiario        TerceroBeneficiario? @relation(fields: [beneficiarioId], references: [id])
  noDocumento         String?             @map("no_documento")
  noCheque            String?             @map("no_cheque")
  anioLectivoId       Int                 @map("anio_lectivo_id")
  anioLectivo         AnioLectivo         @relation(fields: [anioLectivoId], references: [id])
  mes                 Int
  origen              OrigenComprobante   @default(MANUAL)
  estado              EstadoComprobante   @default(CUADRADO)
  creadoEn            DateTime            @default(now()) @map("creado_en")

  asientos              AsientoContable[]
  depreciacionesMes     DepreciacionMensual[]
  cajaChicaReembolsos   CajaChicaMovimiento[]
  recibosDetalleGenerados ReciboDetalle[]
  iccmAsignaciones        IccmAsignacionMensual[]  @relation("IccmAsignacionComprobante")
  iccmRegalos             IccmRegalo[]             @relation("IccmRegaloComprobante")
  iccmAjustes             IccmAjusteMensual[]      @relation("IccmAjusteComprobante")
  iccmConciliacionesComision IccmConciliacionMensual[] @relation("IccmComisionComprobante")
  pagoProveedor              PagoProveedor?
  cierresAnuales             CierreAnual[]             @relation("CierreAnualComprobante")
  planillasMensuales         PlanillaMensual[]         @relation("PlanillaComprobante")

  @@unique([colegioId, libro, claveComprobante])
  @@map("comprobantes")
}

enum TipoMovimientoContable {
  DEBITO
  CREDITO
}

enum Moneda {
  NIO
  USD
}

model AsientoContable {
  id                  BigInt                 @id @default(autoincrement())
  comprobanteId       BigInt                 @map("comprobante_id")
  comprobante         Comprobante            @relation(fields: [comprobanteId], references: [id])
  numeroLinea         Int                    @map("numero_linea")
  cuentaId            Int                    @map("cuenta_id") // debe ser una cuenta tipo DETALLE
  cuenta              CatalogoCuenta         @relation(fields: [cuentaId], references: [id])
  movimiento          TipoMovimientoContable
  moneda              Moneda                 @default(NIO)
  tasaCambio          Decimal                @default(1) @db.Decimal(10, 4) @map("tasa_cambio")
  montoMonedaOrigen   Decimal                @db.Decimal(14, 2) @map("monto_moneda_origen")
  debitoC             Decimal                @default(0) @db.Decimal(14, 2) @map("debito_c")
  creditoC            Decimal                @default(0) @db.Decimal(14, 2) @map("credito_c")

  @@index([comprobanteId])
  @@index([cuentaId])
  @@map("asientos_contables")
}

