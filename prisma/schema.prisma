// ============================================================================
// 9. PROGRAMA ICCM (Apadrinamiento / Sponsorship) -- Libro contable "ICCM"
// ============================================================================
// Fuente: Sistema_Contable_ICCM_2026.xlsm + Apadrinamientos_Consolidado_2026.xlsx
//
// El Programa ICCM es una "empresa" contable aparte del colegio: recibe
// patrocinios en dólares desde FMC-USA y los reporta/entrega mes a mes a
// los 3 colegios. Comparte el mismo motor de Comprobante/AsientoContable,
// pero con su PROPIO catálogo de cuentas (libro = ICCM) para no mezclarse
// con la contabilidad en córdobas de cada colegio.

enum EstadoNinoIccm {
  ACTIVO // tiene patrocinador asignado actualmente
  EN_ESPERA // sin patrocinador (nunca tuvo, o quedó libre)
  DE_BAJA
}

model IccmNino {
  id                 Int            @id @default(autoincrement())
  /// Código único que asigna ICCM, ej. "NC100-00118" (el prefijo NC100/
  /// NC200/NC300 indica el colegio -- ver `Colegio.prefijoIccm`).
  codigoNc           String         @unique @map("codigo_nc")
  colegioId          Int            @map("colegio_id")
  colegio            Colegio        @relation(fields: [colegioId], references: [id])
  /// Enlace opcional a su ficha como estudiante del colegio (no todos los
  /// niños patrocinados tienen todavía su código de estudiante cargado).
  estudianteId       Int?           @unique @map("estudiante_id")
  estudiante         Estudiante?    @relation(fields: [estudianteId], references: [id])
  nombreCompleto     String         @map("nombre_completo")
  /// Nombre del padrino/patrocinador tal como aparece en los reportes de
  /// FMC-USA (solo texto informativo, no se guardan más datos personales
  /// de él por ahora).
  patrocinadorNombre String?        @map("patrocinador_nombre")
  cuotaMensualUsd    Decimal        @db.Decimal(10, 2) @map("cuota_mensual_usd")
  estado             EstadoNinoIccm @default(ACTIVO)

  asignacionesMensuales IccmAsignacionMensual[]
  regalos               IccmRegalo[]

  @@map("iccm_ninos")
}

/// Un renglón por niño por mes: cuánto le correspondía y si ese mes estuvo
/// retenido. Viene directamente del "Disbursement Advice" / reporte
/// "On Time or Overdue" mensual de ICCM -- no se calcula, se importa.
/// Refleja los 3 valores reales que trae la columna "Retenido este mes" del
/// libro de Apadrinamientos -- desde 2024 ICCM reporta explícitamente un
/// tercer estado ("Sin dato") además de Sí/No, y NO se debe forzar a
/// verdadero/falso: Eduardo pidió (7 sept 2026) dejarlo tal cual está
/// reportado y verificarlo más adelante, en vez de asumir un valor.
enum EstadoRetencionIccm {
  RETENIDO
  NO_RETENIDO
  SIN_DATO
}

model IccmAsignacionMensual {
  id              BigInt              @id @default(autoincrement())
  ninoId          Int                 @map("nino_id")
  nino            IccmNino            @relation(fields: [ninoId], references: [id])
  anio            Int
  mes             Int
  /// Monto que le correspondería si NO estuviera retenido.
  montoBase       Decimal             @db.Decimal(10, 2) @map("monto_base")
  /// RETENIDO = ese mes el reporte de ICCM marcó al niño con fondos
  /// retenidos (foto y/o carta vencida) -- se le asigna $0 de ingreso ese
  /// mes. SIN_DATO = el reporte de origen no trae el dato (aparece desde
  /// 2024 en el histórico) -- NO se asume retenido ni no-retenido; queda
  /// marcado así hasta que se verifique con la fuente real.
  estadoRetencion EstadoRetencionIccm @default(NO_RETENIDO) @map("estado_retencion")
  /// ej. "Letter", "Photo", "Photo+Letter" (tal como los clasifica ICCM).
  motivoRetencion String?             @map("motivo_retencion")
  /// = 0 si `estadoRetencion = RETENIDO`; si no (incluyendo SIN_DATO) =
  /// `montoBase`, salvo que se trate de un registro histórico importado,
  /// en cuyo caso se guarda el monto realmente recibido según el Excel de
  /// origen (no se recalcula). Se guarda ya resuelto para que los reportes
  /// no tengan que repetir la regla.
  montoAsignado   Decimal             @db.Decimal(10, 2) @map("monto_asignado")
  comprobanteId   BigInt?             @map("comprobante_id")
  comprobante     Comprobante?        @relation("IccmAsignacionComprobante", fields: [comprobanteId], references: [id])

  @@unique([ninoId, anio, mes])
  @@map("iccm_asignaciones_mensuales")
}

enum TipoRegaloIccm {
  CHILD_GIFT // regalo dirigido a un niño específico
  NON_CHILD_GIFT // donación no ligada a un niño (proyectos, escuela en general)
}

model IccmRegalo {
  id            Int            @id @default(autoincrement())
  ninoId        Int?           @map("nino_id") // null cuando es NON_CHILD_GIFT
  nino          IccmNino?      @relation(fields: [ninoId], references: [id])
  colegioId     Int?           @map("colegio_id") // usado cuando ninoId es null
  colegio       Colegio?       @relation(fields: [colegioId], references: [id])
  tipo          TipoRegaloIccm
  fecha         DateTime       @db.Date
  monto         Decimal        @db.Decimal(10, 2)
  nota          String?
  comprobanteId BigInt?        @map("comprobante_id")
  comprobante   Comprobante?   @relation("IccmRegaloComprobante", fields: [comprobanteId], references: [id])

  @@map("iccm_regalos")
}

enum TipoAjusteIccm {
  /// "Release funds": se liberan fondos que habían quedado retenidos en
  /// meses anteriores (el niño dejó de estar retenido). Viene como una
  /// línea de una sola vez en el Disbursement Advice, no por niño.
  RELEASE_FUNDS
  /// Corrección de un error de un mes previo, reportada por ICCM.
  CORRECTION
}

/// Ajustes de una sola vez que reporta ICCM y que NO son atribuibles a un
/// niño específico (ver Notas y Metodología del libro de Apadrinamientos).
model IccmAjusteMensual {
  id            Int            @id @default(autoincrement())
  anio          Int
  mes           Int
  tipo          TipoAjusteIccm
  monto         Decimal        @db.Decimal(10, 2)
  descripcion   String?
  comprobanteId BigInt?        @map("comprobante_id")
  comprobante   Comprobante?   @relation("IccmAjusteComprobante", fields: [comprobanteId], references: [id])

  @@map("iccm_ajustes_mensuales")
}

enum EstadoConciliacionIccm {
  CUADRA
  REVISAR
  SIN_DATO
}

/// Un renglón por mes: compara lo reportado por FMC-USA contra lo que
/// realmente acreditó el banco, tal como la hoja "Conciliacion bancaria"
/// del libro de Apadrinamientos. Los depósitos llegan con ~1 mes de
/// desfase respecto al mes que reportan (ver `mesRecepcionBanco`).
model IccmConciliacionMensual {
  id                             Int                    @id @default(autoincrement())
  anio                           Int
  mes                            Int
  totalReportadoFmc              Decimal                @db.Decimal(10, 2) @map("total_reportado_fmc")
  /// Comisión del banco EXTRANJERO (Estados Unidos) que FMC-USA descuenta
  /// ANTES de acreditar la transferencia -- variable según el monto que se
  /// transfiere (Eduardo la ubica alrededor de US$5, pero no es un monto
  /// fijo garantizado; puede ser 0 algunos meses). Confirmado con Eduardo
  /// el 7 sept 2026.
  comisionBancariaInternacional  Decimal                @default(0) @db.Decimal(10, 2) @map("comision_bancaria_internacional")
  totalEsperadoAcreditado        Decimal                @db.Decimal(10, 2) @map("total_esperado_acreditado")
  totalRecibidoBanco             Decimal?               @db.Decimal(10, 2) @map("total_recibido_banco")
  /// Mes calendario en que realmente entró el depósito (normalmente el mes
  /// siguiente al que se está reportando).
  mesRecepcionBanco              String?                @map("mes_recepcion_banco")
  diferencia                     Decimal                @default(0) @db.Decimal(10, 2)
  estado                         EstadoConciliacionIccm @default(SIN_DATO)
  /// Comisión del banco NACIONAL (BAC Nicaragua) que se cobra COMO UN
  /// DÉBITO APARTE Y POSTERIOR en la cuenta -- no afecta el monto
  /// acreditado, pero sí es un gasto real mensual de la organización.
  /// CORREGIDO el 7 sept 2026: pese a que una versión anterior del Excel la
  /// describía como "US$5 fijos", Eduardo confirmó que el monto fijo de
  /// US$5 corresponde a la comisión del banco EXTRANJERO (arriba) y que
  /// ESTA comisión nacional ronda los US$25, pero VARÍA según el monto que
  /// ingresa cada mes -- no tiene un valor fijo real. Por eso no lleva
  /// @default y se debe informar explícitamente cada mes con el monto que
  /// muestre el estado de cuenta de BAC.
  comisionBacNacional            Decimal                @db.Decimal(10, 2) @map("comision_bac_nacional")
  comisionBacRegistrada          Boolean                @default(false) @map("comision_bac_registrada")
  comprobanteComisionId          BigInt?                @map("comprobante_comision_id")
  comprobanteComision            Comprobante?           @relation("IccmComisionComprobante", fields: [comprobanteComisionId], references: [id])

  @@unique([anio, mes])
  @@map("iccm_conciliaciones_mensuales")
}

// ============================================================================
// 10. MÓDULO DE PAGO A PROVEEDORES (Egresos) -- pedido de Eduardo 7 sept 2026
// ============================================================================
// Cubre los 11 puntos de la especificación: proveedor, forma de pago,
// numeración automática (o número de cheque), factura, retención automática
// (2%/10%), concepto, cuentas de gasto (multi-línea), historial del
// proveedor, y jornalización automática -- todo en una sola transacción,
// igual que `procesarPago()` en el módulo de cobros.

/// Cómo salió el dinero. Deliberadamente distinto del `FormaPago` de cobros
/// (Efectivo/Transferencia/Tarjeta) porque acá Eduardo pidió exactamente
/// estas 3 opciones para egresos.
enum FormaPagoProveedor {
  CAJA_GENERAL
  TRANSFERENCIA
  CHEQUE
}

/// Decide la regla de retención (punto 7): compra o servicio general = 2%
/// (solo si la factura > C$1,000, calculado ANTES de IVA); servicio
/// profesional = 10% sobre el monto total del servicio (sin IVA en este
/// esquema, según lo indicado por Eduardo).
enum TipoGastoRetencion {
  COMPRA_O_SERVICIO_GENERAL
  SERVICIO_PROFESIONAL
}

/// Contador independiente para la numeración "YY-X-NN" del punto 5 (X=letra
/// de mes A=enero...L=diciembre, NN reinicia cada mes). Es EL MISMO esquema
/// que ya usaba el libro diario histórico de ICCM (ej. "H-01"), así que se
/// reutiliza el patrón que Eduardo ya conoce de sus propios Excel. Solo
/// aplica a pagos por Caja General o Transferencia -- Cheque usa el número
/// de cheque tal cual (no consume este contador).
model ComprobanteContadorMensual {
  id           Int           @id @default(autoincrement())
  colegioId    Int           @map("colegio_id")
  colegio      Colegio       @relation(fields: [colegioId], references: [id])
  libro        LibroContable @default(COLEGIO)
  anio         Int
  mes          Int
  ultimoNumero Int           @default(0) @map("ultimo_numero")

  @@unique([colegioId, libro, anio, mes])
  @@map("comprobante_contador_mensual")
}

model PagoProveedor {
  id                         BigInt              @id @default(autoincrement())
  colegioId                  Int                 @map("colegio_id")
  colegio                    Colegio             @relation(fields: [colegioId], references: [id])
  libro                      LibroContable       @default(COLEGIO)
  proveedorId                Int                 @map("proveedor_id")
  proveedor                  TerceroBeneficiario @relation(fields: [proveedorId], references: [id])
  fechaPago                  DateTime            @db.Date @map("fecha_pago")
  formaPago                  FormaPagoProveedor  @map("forma_pago")
  /// Cuenta de la que sale el dinero: Caja General (110101), o el banco
  /// específico (ej. 11010301 BAC NIO) para Transferencia/Cheque.
  cuentaOrigenId             Int                 @map("cuenta_origen_id")
  cuentaOrigen               CatalogoCuenta      @relation("CuentaOrigenPago", fields: [cuentaOrigenId], references: [id])
  /// El texto que identifica este pago: "26-A-01" (Caja General/Transferencia,
  /// generado por `ComprobanteContadorMensual`) o el número de cheque tal
  /// cual (Cheque) -- ver punto 5 de la especificación.
  numeroComprobantePago      String              @map("numero_comprobante_pago")
  numeroFactura              String?             @map("numero_factura")
  conceptoPago               String              @map("concepto_pago")
  tipoGasto                  TipoGastoRetencion  @map("tipo_gasto")
  /// Monto total de la factura (con IVA incluido si aplica).
  montoFactura               Decimal             @db.Decimal(12, 2) @map("monto_factura")
  /// Solo relevante para COMPRA_O_SERVICIO_GENERAL: el monto ANTES de IVA
  /// sobre el que se calcula el 2%. Si es null se usa `montoFactura` completo
  /// (asume que no hay IVA separado en esa factura).
  baseImponibleSinIva        Decimal?            @db.Decimal(12, 2) @map("base_imponible_sin_iva")
  /// true si al momento de este pago el proveedor tenía constancia de no
  /// retención vigente -- se guarda como "fotografía" del momento, aunque
  /// después venza o se le quite la constancia.
  exoneradoPorConstancia     Boolean             @default(false) @map("exonerado_por_constancia")
  porcentajeRetencionAplicado Decimal            @default(0) @db.Decimal(5, 2) @map("porcentaje_retencion_aplicado")
  montoRetencion             Decimal             @default(0) @db.Decimal(12, 2) @map("monto_retencion")
  /// Cuenta DETALLE de retención DGI acreditada -- "21060202 IR Compra De
  /// Bienes Y Servicios" (2%) o "21060203 IR Servicios Profesionales" (10%)
  /// según `tipoGasto`. null cuando no hubo retención (exonerado o factura
  /// bajo el umbral).
  cuentaRetencionId          Int?                @map("cuenta_retencion_id")
  cuentaRetencion            CatalogoCuenta?     @relation("CuentaRetencionPago", fields: [cuentaRetencionId], references: [id])
  /// = montoFactura - montoRetencion. Lo que realmente sale de Caja/Banco.
  montoNetoPagado            Decimal             @db.Decimal(12, 2) @map("monto_neto_pagado")
  comprobanteId              BigInt?             @unique @map("comprobante_id")
  comprobante                Comprobante?        @relation(fields: [comprobanteId], references: [id])
  creadoPor                  String?             @map("creado_por")
  creadoEn                   DateTime            @default(now()) @map("creado_en")

  detalle PagoProveedorDetalle[]

  @@index([proveedorId])
  @@map("pagos_proveedor")
}

/// Punto 9: multi-línea de cuentas de gasto que juntas deben sumar
/// `PagoProveedor.montoFactura` (se valida antes de guardar nada).
model PagoProveedorDetalle {
  id            Int            @id @default(autoincrement())
  pagoId        BigInt         @map("pago_id")
  pago          PagoProveedor  @relation(fields: [pagoId], references: [id])
  cuentaGastoId Int            @map("cuenta_gasto_id")
  cuentaGasto   CatalogoCuenta @relation(fields: [cuentaGastoId], references: [id])
  monto         Decimal        @db.Decimal(12, 2)
  descripcion   String?

  @@map("pago_proveedor_detalle")
}

// ============================================================================
// 11. LIBRO DIARIO / LIBRO MAYOR
// ============================================================================
// No llevan tablas propias -- son REPORTES sobre `Comprobante`/`AsientoContable`
// que ya existen (ver src/lib/reportes/libro-diario.ts y libro-mayor.ts). Se
// documentan acá solo para dejar constancia de la decisión de diseño.

// ============================================================================
// 12. CIERRES CONTABLES (Mensual y Anual)
// ============================================================================

enum EstadoCierre {
  ABIERTO
  CERRADO
}

/// Un renglón por colegio+libro+mes. Mientras esté ABIERTO, el mes admite
/// nuevos comprobantes con fecha dentro de ese mes; una vez CERRADO, el motor
/// de partida doble (`procesarPago`, `registrarPagoProveedor`, etc.) debe
/// RECHAZAR cualquier intento de crear un comprobante con fecha en un mes
/// cerrado -- así los reportes ya generados no pueden quedar desactualizados
/// en silencio.
model CierreContable {
  id                      Int           @id @default(autoincrement())
  colegioId               Int           @map("colegio_id")
  colegio                 Colegio       @relation(fields: [colegioId], references: [id])
  libro                   LibroContable @default(COLEGIO)
  anio                    Int
  mes                     Int
  estado                  EstadoCierre  @default(ABIERTO)
  fechaCierre             DateTime?     @map("fecha_cierre")
  cerradoPor              String?       @map("cerrado_por")
  /// Snapshots congelados de los 3 reportes AL MOMENTO del cierre. Una vez
  /// cerrado, estos JSON ya no se recalculan (para volver a generarlos hay
  /// que reabrir el mes explícitamente).
  balanzaComprobacionJson Json?         @map("balanza_comprobacion_json")
  estadoResultadosJson    Json?         @map("estado_resultados_json")
  balanceGeneralJson      Json?         @map("balance_general_json")
  creadoEn                DateTime      @default(now()) @map("creado_en")

  @@unique([colegioId, libro, anio, mes])
  @@map("cierres_contables")
}

/// Cierre anual: requiere los 12 meses de `CierreContable` ya CERRADOS.
/// Genera el asiento de cierre (cancela cuentas de Ingreso/Costo/Gasto contra
/// Resultados Acumulados / Patrimonio) y dispara el "AUTO_CIERRE" que ya
/// contemplaba `OrigenComprobante`.
model CierreAnual {
  id                   Int           @id @default(autoincrement())
  colegioId            Int           @map("colegio_id")
  colegio              Colegio       @relation(fields: [colegioId], references: [id])
  libro                LibroContable @default(COLEGIO)
  anio                 Int
  estado               EstadoCierre  @default(ABIERTO)
  fechaCierre          DateTime?     @map("fecha_cierre")
  utilidadEjercicio    Decimal?      @db.Decimal(14, 2) @map("utilidad_ejercicio")
  comprobanteCierreId  BigInt?       @map("comprobante_cierre_id")
  comprobanteCierre    Comprobante?  @relation("CierreAnualComprobante", fields: [comprobanteCierreId], references: [id])
  estadoResultadosJson Json?         @map("estado_resultados_json")
  balanceGeneralJson   Json?         @map("balance_general_json")
  creadoEn             DateTime      @default(now()) @map("creado_en")

  @@unique([colegioId, libro, anio])
  @@map("cierres_anuales")
}

// ============================================================================
// 13. MÓDULO DE NÓMINAS (planos -- pendiente el Excel de nómina de Eduardo)
// ============================================================================
// Diseño provisional que ya soporta los 4 esquemas que Eduardo describió
// (7 sept 2026), pero SIN calcular todavía INSS patronal/laboral ni tablas
// de IR por tramos de la DGI -- esos porcentajes/tramos deben confirmarse
// contra el Excel de nómina real (avisar a Eduardo, ver bitácora). Por ahora
// el sistema registra el salario bruto, aplica SOLO las retenciones que
// Eduardo ya confirmó explícitamente (10%/2% para el Instituto) y deja el
// resto de las deducciones como campos manuales editables.
//
// ACTUALIZADO 7 sept 2026: Eduardo subió los 3 Excel reales de nómina
// ("04 NÓMINAS 2026 1/1./2.xlsx"). Se identificaron por el nombre real del
// colegio en la hoja "COLILLAS" de cada uno:
//   - Personal fijo de "COLEGIO PRIVADO METODISTA LIBRE DE NICARAGUA - EL
//     MESÍAS" (14 empleados: Dexton, Marlon, Ingrid...).
//   - Personal fijo del "INSTITUTO TECNOLÓGICO METODISTA LIBRE DE NICARAGUA"
//     (Josseling, Jamileth, Brenda... -- misma estructura que El Mesías).
//   - "PAGO POR SERVICIOS" del mismo Instituto (Lester, Gustavo... Servicio
//     General 2%; Peter Robinson, Servicio Profesional 10%).
// Con esos 3 archivos se confirmaron las fórmulas REALES (columnas AE-AH de
// cada hoja mensual, ej. "AGOST 2026"):
//   INSS Laboral   = (Total Ingresos - Viáticos Transporte) * 7%
//   INSS Patronal  = Salario Cotizado * 21.5% ("CUOTA PATRONAL POR PAGAR
//                    (21.5%)" -- tasa para empleadores con MENOS de 50
//                    trabajadores; la ley nicaragüense sube a 22.5% a partir
//                    de 50 trabajadores, que es la cifra que Eduardo mencionó
//                    de memoria -- ninguno de los 3 colegios llega a 50
//                    empleados todavía, así que 21.5% es la correcta hoy).
//   IR             = NINGUNO de los 3 Excel reales calcula IR mensual
//                    todavía (ni admin ni docentes) -- se implementa la
//                    tabla progresiva completa de Ley 822 (confirmada contra
//                    fuentes públicas actualizadas de legislación laboral
//                    nicaragüense 2026) para cuando algún salario la
//                    supere, pero HOY da C$0 para todos los empleados reales
//                    de los 3 archivos (ninguno supera el tramo exento).
//   INATEC         = los 3 Excel reales lo traen en CERO (no lo están
//                    aplicando) -- se deja APAGADO por defecto
//                    (`aplicarInatec`), a confirmar con Eduardo si el
//                    colegio está exonerado o si debería empezar a
//                    aplicarse (por ley es 2% patronal).
//   Servicio Profesional (docente por hora) = 10% -- confirmado exacto.
//   Servicio General (contrato) = 2% -- confirmado exacto.
// Nota de calidad de datos: en el archivo de "PAGO POR SERVICIOS" del
// Instituto, un docente (Peter Joseph Robinson Talavera) aparece en Febrero
// 2026 como "Servicio Profesional" con 10% correcto, pero de Marzo en
// adelante alguien le cambió la etiqueta a "Docente" y la fórmula se quedó
// pegada en 2% (arrastrada de las filas de arriba) -- es un error de la
// plantilla real de Eduardo, no una regla nueva. Avisar para que lo revise.
//
// ACTUALIZADO 7 sept 2026 (de noche): Eduardo subió los 2 Excel reales de
// El Buen Pastor ("04 NÓMINAS 2026 1 5.xlsx" = personal INSCRITO al INSS,
// tiene hojas "Decla. Inss [Mes]"; "04 NÓMINAS 2026 2 2.xlsx" = personal
// NO inscrito, INSS Laboral en C$0 en las 24 quincenas revisadas). Ambos
// esquemas quedan CONFIRMADOS contra datos reales (enero-marzo 2026, 8
// empleados, 3 meses):
//   - Pagan QUINCENAL, pero el INSS Laboral (7%) del personal inscrito se
//     retiene TODO junto en la 2da quincena del mes (0% en la 1ra) -- ya
//     que 14% de un pago quincenal = 7% del salario mensual completo, el
//     total mensual retenido es idéntico a un esquema mensual normal, así
//     que la `PlanillaMensual` (mensual) no necesitó ningún cambio de
//     estructura para modelarlo -- ver `calcularDeduccionesNomina`.
//   - "Piso de cotización" de C$8,341.29/mes (`PISO_COTIZACION_DOCENCIA_
//     MENSUAL` en `inss-ir.ts`): cuando el salario real de un docente/
//     administrativo inscrito es MENOR a este piso, el colegio declara y
//     paga al INSS el 7%/21.5% sobre el piso (no sobre el real), pero solo
//     le deduce al empleado el 7% de su salario real -- la diferencia
//     ("subsidioInssPiso") la asume El Buen Pastor como gasto patronal
//     adicional. Confirmado exacto (24/24 casos) contra la hoja real
//     "Decla. Inss [Mes]" de los 3 meses. Ninguno de los otros 2 colegios
//     usa este piso.
//   - DOCENTE_NO_INSS: confirmado 0% INSS en las 48 quincenas reales
//     revisadas (2 quincenas x 3 meses x 8 empleados) -- ya no es
//     provisional.
//   - IR: tampoco aparece en ninguno de los 2 Excel de Buen Pastor (mismo
//     patrón que El Mesías/Instituto) -- sigue en C$0 hasta que algún
//     salario supere el tramo exento de Ley 822.

enum TipoNomina {
  /// Instituto: docentes pagados por hora/clase -- 10% de retención.
  DOCENTE_HORARIO
  /// Instituto: trabajadores con contrato por servicios generales -- 2% de retención.
  CONTRATO_SERVICIOS_GENERALES
  /// Instituto (personal fijo) y El Mesías -- misma estructura de nómina fija.
  PERSONAL_FIJO
  /// El Buen Pastor: maestros inscritos al INSS.
  DOCENTE_INSS
  /// El Buen Pastor: maestros NO inscritos al INSS.
  DOCENTE_NO_INSS
}

model Empleado {
  id              Int         @id @default(autoincrement())
  colegioId       Int         @map("colegio_id")
  colegio         Colegio     @relation(fields: [colegioId], references: [id])
  nombreCompleto  String      @map("nombre_completo")
  cedula          String?
  cargo           String?
  tipoNomina      TipoNomina  @map("tipo_nomina")
  /// Solo relevante para El Buen Pastor -- si está inscrito o no al INSS
  /// (para el resto de colegios/esquemas queda en false y no se usa).
  inscritoInss    Boolean     @default(false) @map("inscrito_inss")
  salarioBase     Decimal?    @db.Decimal(12, 2) @map("salario_base") // PERSONAL_FIJO / DOCENTE_INSS / DOCENTE_NO_INSS
  tarifaPorHora   Decimal?    @db.Decimal(12, 2) @map("tarifa_por_hora") // DOCENTE_HORARIO
  activo          Boolean     @default(true)
  fechaIngreso    DateTime?   @db.Date @map("fecha_ingreso")

  detallePlanilla PlanillaDetalle[]

  @@map("empleados")
}

model PlanillaMensual {
  id            Int           @id @default(autoincrement())
  colegioId     Int           @map("colegio_id")
  colegio       Colegio       @relation(fields: [colegioId], references: [id])
  tipoNomina    TipoNomina    @map("tipo_nomina")
  anio          Int
  mes           Int
  estado        EstadoCierre  @default(ABIERTO) // ABIERTO = en edición, CERRADO = pagada y jornalizada
  comprobanteId BigInt?       @map("comprobante_id")
  comprobante   Comprobante?  @relation("PlanillaComprobante", fields: [comprobanteId], references: [id])
  creadoEn      DateTime      @default(now()) @map("creado_en")

  detalle PlanillaDetalle[]

  @@unique([colegioId, tipoNomina, anio, mes])
  @@map("planillas_mensuales")
}

model PlanillaDetalle {
  id                  Int             @id @default(autoincrement())
  planillaId          Int             @map("planilla_id")
  planilla            PlanillaMensual @relation(fields: [planillaId], references: [id])
  empleadoId          Int             @map("empleado_id")
  empleado            Empleado        @relation(fields: [empleadoId], references: [id])
  /// Solo DOCENTE_HORARIO: cantidad de horas/clases del mes.
  horasOClases        Decimal?        @db.Decimal(8, 2) @map("horas_o_clases")
  /// "Total Ingresos" del periodo (igual que la columna M del Excel real):
  /// salario ordinario + feriados + subsidio + vacaciones, SIN viáticos.
  salarioBruto        Decimal         @db.Decimal(12, 2) @map("salario_bruto")
  /// = (salarioBruto - viáticos) * 7% -- confirmado exacto contra el Excel
  /// real (fórmula "=(Total Ingresos - Viáticos)*7%"). Solo PERSONAL_FIJO/
  /// DOCENTE_INSS; 0 para los demás esquemas.
  inssLaboral         Decimal         @default(0) @db.Decimal(12, 2) @map("inss_laboral")
  /// = salarioBruto * 21.5% (o 22.5% si el colegio ya tiene 50+ empleados) --
  /// GASTO patronal adicional, NO reduce el salario neto del empleado.
  /// Confirmado exacto contra el Excel real ("CUOTA PATRONAL POR PAGAR
  /// (21.5%)"). Solo PERSONAL_FIJO/DOCENTE_INSS; 0 para los demás esquemas.
  inssPatronal        Decimal         @default(0) @db.Decimal(12, 2) @map("inss_patronal")
  /// = salarioBruto * 2% -- GASTO patronal adicional (Ley), NO reduce el
  /// salario neto. Los 3 Excel reales de Eduardo lo traen en CERO (no lo
  /// aplican) -- por eso queda en 0 salvo que se active `aplicarInatec`.
  inatecPatronal      Decimal         @default(0) @db.Decimal(12, 2) @map("inatec_patronal")
  /// IR mensual por la tabla progresiva de Ley 822 (proyección anual del
  /// salario neto de INSS, dividido entre 12) -- da C$0 mientras el salario
  /// no supere el tramo exento (hoy ningún empleado real de los 3 Excel lo
  /// supera). Solo PERSONAL_FIJO/DOCENTE_INSS/DOCENTE_NO_INSS.
  irMensual           Decimal         @default(0) @db.Decimal(12, 2) @map("ir_mensual")
  /// Solo DOCENTE_INSS (El Buen Pastor) cuando el salario real del empleado
  /// no alcanza el "piso de cotización" (`PISO_COTIZACION_DOCENCIA_MENSUAL`,
  /// hoy C$8,341.29/mes): = inssLaboral-que-hay-que-pagar-al-INSS-sobre-el-
  /// piso MENOS inssLaboral-deducido-al-empleado-sobre-su-salario-real.
  /// Gasto patronal adicional (el colegio completa la cotización mínima de
  /// su bolsillo) -- confirmado exacto (24/24) contra la hoja real "Decla.
  /// Inss [Mes]". 0 para todos los demás esquemas/colegios.
  subsidioInssPiso    Decimal         @default(0) @db.Decimal(12, 2) @map("subsidio_inss_piso")
  /// 10% (DOCENTE_HORARIO, "Servicio Profesional") o 2% (CONTRATO_SERVICIOS_GENERALES, "Servicio General") -- confirmado exacto contra el Excel real.
  porcentajeRetencion Decimal         @default(0) @db.Decimal(5, 2) @map("porcentaje_retencion")
  montoRetencion      Decimal         @default(0) @db.Decimal(12, 2) @map("monto_retencion")
  /// = salarioBruto - inssLaboral - irMensual - montoRetencion (inssPatronal/inatecPatronal NO se restan -- son gasto patronal aparte, no deducción del empleado).
  salarioNeto         Decimal         @db.Decimal(12, 2) @map("salario_neto")
  observacion         String?

  @@unique([planillaId, empleadoId])
  @@map("planilla_detalle")
}

// ============================================================================
// 14. USUARIOS Y CONTROL DE ACCESO (inicio de sesión de la aplicación web)
// ============================================================================
// No es parte del catálogo contable -- controla quién puede entrar a cada
// pantalla del sistema (7 sept 2026, pedido de Eduardo para la prueba local).
// Cada usuario tiene UN solo rol; el rol decide qué pantallas ve
// (`src/lib/auth/roles.ts` es la única fuente de verdad de esa relación
// ruta<->rol, para no repetirla en cada pantalla).

enum RolUsuario {
  /// Solo Pantalla de Cajera (Punto de Venta): cobros, ROC, reportes de caja.
  CAJERA
  /// Egresos/Proveedores, Nóminas, Retenciones DGI, Libro Diario/Mayor y Cierres.
  CONTADOR
  /// Dashboard Consolidado (las 3 sedes) y auditoría ICCM.
  JUNTA_DIRECTIVA
}

model Usuario {
  id             Int        @id @default(autoincrement())
  /// Nombre de usuario para iniciar sesión (no es un correo).
  usuario        String     @unique @db.VarChar(40)
  nombreCompleto String     @db.VarChar(150) @map("nombre_completo")
  /// Hash bcrypt -- la contraseña en texto plano NUNCA se guarda en la base de datos.
  passwordHash   String     @map("password_hash")
  rol            RolUsuario
  activo         Boolean    @default(true)
  creadoEn       DateTime   @default(now()) @map("creado_en")

  @@map("usuarios")
}
