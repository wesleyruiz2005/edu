  cuentaActivoId            Int             @map("cuenta_activo_id")
  cuentaActivo              CatalogoCuenta  @relation("CategoriaCuentaActivo", fields: [cuentaActivoId], references: [id])
  cuentaDeprecAcumuladaId   Int             @map("cuenta_deprec_acumulada_id")
  cuentaDeprecAcumulada     CatalogoCuenta  @relation("CategoriaCuentaDeprecAcumulada", fields: [cuentaDeprecAcumuladaId], references: [id])
  cuentaGastoId             Int             @map("cuenta_gasto_id")
  cuentaGasto               CatalogoCuenta  @relation("CategoriaCuentaGasto", fields: [cuentaGastoId], references: [id])

  activosFijos ActivoFijo[]

